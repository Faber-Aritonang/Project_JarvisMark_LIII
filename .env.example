# ─── Dodol Environment Variables ───────────────────────────────────────────────
# Copy to .env and fill in your values.
# These override values in config/api_keys.json at startup.

# Gemini API key (required) — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google OAuth (optional — for Gmail, Calendar, Drive plugins)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tuya Smart Home (optional — for IoT device control)
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=

# OpenAI-compatible endpoint (optional — used by dev_agent for code tasks)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Dashboard (optional — override defaults)
# DASHBOARD_PORT=8000
# DASHBOARD_SSL=true
